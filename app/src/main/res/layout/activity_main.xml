<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- частота A4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/minusBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/card_bg"
            android:gravity="center"
            android:text="−"
            android:textColor="#8A8A8A"
            android:textSize="30sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/card_bg"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:text="A"
                android:textColor="#8A8A8A"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/a4Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="432 Hz"
                android:textColor="#8A8A8A"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/plusBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/card_bg"
            android:gravity="center"
            android:text="+"
            android:textColor="#8A8A8A"
            android:textSize="30sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- профили -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/profChromatic"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/card_bg_active"
            android:gravity="center"
            android:text="ХРОМАТИЧЕСКИЙ"
            android:textColor="#8A8A8A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/profGusli"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/card_bg"
            android:gravity="center"
            android:text="ГУСЛИ"
            android:textColor="#8A8A8A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.tunerapp.chromatic.TunerDisplayView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/statusMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text=""
        android:textColor="#8A8A8A"
        android:textSize="12sp" />

</LinearLayout>
